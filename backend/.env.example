# MySQL connection. Replace YOUR_PASSWORD with the MySQL root password.
# The database "invoice_db" is created automatically on first start.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/invoice_db

# Long random text used to sign login tokens. Change it before going live.
SECRET_KEY=change-this-to-a-long-random-string

# First login account (only used when the database has no users yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

CORS_ORIGINS=*

# Companies shown in the app: APX = APXpress, CRX = Creonetix.
ACTIVE_COMPANIES=APX,CRX

# Where uploaded logos are saved. On Railway use the volume path, e.g. /data/uploads
# UPLOAD_DIR=/data/uploads
